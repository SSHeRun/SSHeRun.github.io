---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import heroScene from '../assets/hero-agent-friendly-blog.jpg';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { currentLocale, localizedPath } from '../i18n/config';
import { postPath, postsForLocale, translationKey } from '../i18n/posts';
import { clusterLabel, t, tagLabel } from '../i18n/ui';
import { FEATURED_KEYS } from '../lib/featured';
import { TAG_CLUSTERS } from '../lib/taxonomy';

const locale = currentLocale(Astro.currentLocale);
const posts = postsForLocale(await getCollection('blog'), locale).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 5);
const featured = FEATURED_KEYS.map((key) => posts.find((post) => translationKey(post) === key)).filter(
	(post): post is (typeof posts)[number] => post !== undefined,
);

const totalUnits = posts.reduce((sum, post) => {
	const body = post.body ?? '';
	return sum + (locale === 'en' ? body.split(/\s+/).filter(Boolean).length : (body.match(/[\u4e00-\u9fff]/g) ?? []).length);
}, 0);
const volume =
	locale === 'en' ? `${Math.round(totalUnits / 1000)}k` : `${Math.round(totalUnits / 10000)}`;

const shown = new Set([...latest, ...featured].map((post) => post.id));
const clusters = TAG_CLUSTERS.map((cluster) => {
	const items = posts.filter((post) => (post.data.tags ?? []).some((tag) => cluster.tags.includes(tag)));
	const recent = items.filter((post) => !shown.has(post.id)).slice(0, 2);
	recent.forEach((post) => shown.add(post.id));
	return { ...cluster, count: items.length, recent };
}).filter((cluster) => cluster.count > 0);

const stats = [
	{ value: String(posts.length), label: t(locale, 'statPosts') },
	{ value: volume, label: t(locale, 'statWords') },
	{ value: String(clusters.length), label: t(locale, 'statThemes') },
	{ value: '2', label: t(locale, 'statLanguages') },
];
const blogPath = localizedPath(locale, '/blog/');
---

<section class="hero">
	<div class="hero-visual" aria-hidden="true">
		<Image
			src={heroScene}
			alt=""
			width={1600}
			height={800}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			class="hero-scene"
		/>
		<div class="hero-fade"></div>
	</div>
	<div class="hero-mesh"></div>
	<div class="hero-content">
		<span class="hero-pill glass">{t(locale, 'heroPill')}</span>
		<h1>{t(locale, 'heroTitleBefore')} <span class="accent">Agent</span>{t(locale, 'heroTitleAfter')}</h1>
		<p class="subtitle">{t(locale, 'heroSubtitle')}</p>
		<div class="hero-actions">
			<a class="btn primary" href={localizedPath(locale, '/start/')}>{t(locale, 'ctaStart')}</a>
			<a class="btn" href={blogPath}>{t(locale, 'ctaAllPosts')}</a>
			<a class="btn ghost" href={localizedPath(locale, '/graph/')}>{t(locale, 'ctaGraph')}</a>
		</div>
	</div>
</section>

<dl class="stats glass">
	{stats.map((stat) => (
		<div>
			<dt>{stat.label}</dt>
			<dd>{stat.value}</dd>
		</div>
	))}
</dl>

<section class="block">
	<div class="section-header">
		<h2>{t(locale, 'latestPosts')}</h2>
		<a href={blogPath} class="view-all">{t(locale, 'viewAll')}</a>
	</div>
	<div class="post-list">
		{latest.map((post) => (
			<a href={postPath(locale, post)} class="post-card">
				{post.data.heroImage && (
					<div class="post-image">
						<Image
							src={post.data.heroImage}
							alt={post.data.title}
							width={320}
							height={180}
							loading="lazy"
							transition:name={`post-img-${post.id}`}
						/>
					</div>
				)}
				<div class="post-body">
					<div class="post-meta">
						<FormattedDate date={post.data.pubDate} />
						<TagList tags={post.data.tags} linked={false} compact />
					</div>
					<h3>{post.data.title}</h3>
					{post.data.description && <p>{post.data.description}</p>}
				</div>
			</a>
		))}
	</div>
</section>

<section class="block">
	<div class="section-header">
		<h2>{t(locale, 'themesTitle')}</h2>
		<a href={localizedPath(locale, '/tags/')} class="view-all">{t(locale, 'themesAll')}</a>
	</div>
	<div class="clusters">
		{clusters.map((cluster) => (
			<article class="cluster" style={`--cluster: ${cluster.color}`}>
				<header>
					<span class="cluster-dot" aria-hidden="true"></span>
					<h3>{clusterLabel(locale, cluster.id)}</h3>
					<span class="cluster-count">{t(locale, 'postCount', { n: cluster.count })}</span>
				</header>
				<ul class="cluster-posts">
					{cluster.recent.map((post) => (
						<li>
							<a href={postPath(locale, post)}>{post.data.title}</a>
						</li>
					))}
				</ul>
				<div class="cluster-tags">
					{cluster.tags.map((tag) => (
						<a href={`${blogPath}?tag=${encodeURIComponent(tag)}`}>{tagLabel(locale, tag)}</a>
					))}
				</div>
			</article>
		))}
	</div>
</section>

{
	featured.length > 0 && (
		<section class="block">
			<div class="section-header">
				<h2>{t(locale, 'featuredTitle')}</h2>
				<a href={localizedPath(locale, '/start/')} class="view-all">{t(locale, 'ctaStart')} →</a>
			</div>
			<div class="featured">
				{featured.map((post, index) => (
					<a href={postPath(locale, post)} class="featured-card">
						{post.data.heroImage && (
							<div class="featured-image">
								<Image src={post.data.heroImage} alt="" width={480} height={240} loading="lazy" />
							</div>
						)}
						<div class="featured-body">
							<span class="featured-index">{String(index + 1).padStart(2, '0')}</span>
							<h3>{post.data.title}</h3>
						</div>
					</a>
				))}
			</div>
		</section>
	)
}

<style>
	/* ── Hero ── */
	.hero {
		position: relative;
		padding: 5rem 0 3.5rem;
		overflow: hidden;
		min-height: clamp(300px, 40vw, 440px);
		display: flex;
		align-items: center;
	}
	.hero-visual {
		position: absolute;
		inset: 0;
		z-index: -2;
		pointer-events: none;
	}
	.hero-scene {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 40%;
		opacity: 0.42;
		filter: saturate(1.05) contrast(1.02);
	}
	:global([data-theme='dark']) .hero-scene {
		opacity: 0.55;
	}
	.hero-fade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				90deg,
				var(--bg-base) 0%,
				color-mix(in srgb, var(--bg-base) 82%, transparent) 42%,
				color-mix(in srgb, var(--bg-base) 35%, transparent) 72%,
				transparent 100%
			),
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--bg-base) 20%, transparent) 0%,
				transparent 35%,
				color-mix(in srgb, var(--bg-base) 55%, transparent) 100%
			);
	}
	.hero-mesh {
		position: absolute;
		inset: -60px;
		background:
			radial-gradient(ellipse 600px 350px at 70% 20%, color-mix(in srgb, var(--accent) 15%, transparent), transparent),
			radial-gradient(ellipse 500px 300px at 20% 70%, color-mix(in srgb, var(--accent-secondary) 12%, transparent), transparent),
			radial-gradient(ellipse 300px 200px at 50% 50%, color-mix(in srgb, var(--accent) 6%, transparent), transparent);
		filter: blur(50px);
		pointer-events: none;
		z-index: -1;
		animation: mesh-float 12s ease-in-out infinite alternate;
	}
	@keyframes mesh-float {
		0% { transform: translate(0, 0) scale(1); }
		33% { transform: translate(15px, -10px) scale(1.02); }
		66% { transform: translate(-10px, 8px) scale(0.98); }
		100% { transform: translate(5px, -5px) scale(1.01); }
	}
	.hero-content {
		position: relative;
	}
	.hero-pill {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.3rem 0.9rem;
		border-radius: 999px;
		margin-bottom: 1.25rem;
		box-shadow: inset 0 0 0 1px var(--border-glow);
	}
	.hero h1 {
		font-size: clamp(1.85rem, 1.2rem + 2.4vw, 2.85rem);
		margin: 0 0 0.85rem;
		letter-spacing: -0.035em;
		line-height: 1.18;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	.accent {
		background: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.subtitle {
		font-size: 1.15rem;
		color: var(--text-secondary);
		margin: 0;
		max-width: 560px;
		line-height: 1.7;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 42px;
		padding: 0 1.15rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--text-primary);
		background: var(--bg-surface);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}
	.btn:hover {
		color: var(--accent);
		border-color: var(--border-glow);
		transform: translateY(-1px);
		box-shadow: var(--shadow-glow);
	}
	.btn.primary {
		color: #fff;
		border-color: transparent;
		background: var(--accent-gradient);
	}
	.btn.primary:hover {
		color: #fff;
	}
	:global([data-theme='dark']) .btn.primary,
	:global([data-theme='dark']) .btn.primary:hover {
		color: var(--bg-base);
	}
	.btn.ghost {
		background: transparent;
		box-shadow: none;
	}

	/* ── Stats ── */
	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 0 0 1rem;
		padding: 1.1rem 0.5rem;
		border-radius: var(--radius-lg);
	}
	.stats div {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 0.1rem;
	}
	.stats div + div {
		border-left: 1px solid var(--border);
	}
	.stats dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.65rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
		background: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.stats dt {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	/* ── Sections ── */
	.block {
		padding: 2rem 0 0.5rem;
	}
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1.25rem;
	}
	.section-header h2 {
		font-size: 1.3rem;
		margin: 0;
		letter-spacing: -0.02em;
	}
	.view-all {
		font-size: 0.88rem;
		color: var(--text-muted);
	}
	.view-all:hover {
		color: var(--accent);
	}

	/* ── Latest ── */
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.post-card {
		display: flex;
		gap: 1.25rem;
		padding: 1rem;
		border-radius: var(--radius-lg);
		border: 1px solid transparent;
		transition: all 0.25s ease;
	}
	.post-card:hover {
		background: var(--glass-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-color: var(--glass-border);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.post-image {
		flex-shrink: 0;
		width: 200px;
		height: 112px;
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.post-image img,
	.featured-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.4s ease;
	}
	.post-card:hover .post-image img,
	.featured-card:hover img {
		transform: scale(1.06);
	}
	.post-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.post-card h3 {
		font-size: 1.1rem;
		margin: 0.35rem 0 0.3rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
	}
	.post-card p {
		font-size: 0.88rem;
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	/* ── Clusters ── */
	.clusters {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1rem;
	}
	.cluster {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.1rem 1.15rem 1rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--glass-border);
		background:
			radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--cluster) 14%, transparent), transparent 60%),
			var(--glass-bg);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.cluster:hover {
		border-color: color-mix(in srgb, var(--cluster) 45%, transparent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.cluster header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.cluster-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: var(--cluster);
		box-shadow: 0 0 10px color-mix(in srgb, var(--cluster) 60%, transparent);
	}
	.cluster h3 {
		margin: 0;
		font-size: 1rem;
	}
	.cluster-count {
		margin-left: auto;
		font-size: 0.75rem;
		color: var(--text-muted);
	}
	.cluster-posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}
	.cluster-posts li {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.45;
	}
	.cluster-posts a {
		color: var(--text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.cluster-posts a:hover {
		color: var(--accent);
	}
	.cluster-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.cluster-tags a {
		font-size: 0.72rem;
		padding: 0.08rem 0.5rem;
		border-radius: 999px;
		color: var(--text-secondary);
		background: color-mix(in srgb, var(--cluster) 12%, transparent);
	}
	.cluster-tags a:hover {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--cluster) 22%, transparent);
	}

	/* ── Featured ── */
	.featured {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.featured-card {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--glass-border);
		background: var(--glass-bg);
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}
	.featured-card:hover {
		transform: translateY(-3px);
		border-color: var(--border-glow);
		box-shadow: var(--shadow-glow), var(--shadow-md);
	}
	.featured-image {
		aspect-ratio: 2 / 1;
		overflow: hidden;
	}
	.featured-body {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		padding: 0.8rem 0.95rem 0.95rem;
	}
	.featured-index {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--accent);
	}
	.featured-card h3 {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.45;
		color: var(--text-primary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 720px) {
		.hero {
			padding: 3rem 0 2rem;
		}
		.subtitle {
			font-size: 1.02rem;
		}
		.stats {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 1rem;
		}
		.stats div:nth-child(3) {
			border-left: none;
		}
		.post-card {
			flex-direction: column;
			gap: 0.75rem;
		}
		.post-image {
			width: 100%;
			height: 160px;
		}
		.featured {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 480px) {
		.hero {
			padding: 2rem 0 1.5rem;
		}
		.hero-pill {
			font-size: 0.7rem;
			padding: 0.25rem 0.7rem;
		}
		.subtitle {
			font-size: 0.95rem;
		}
		.btn {
			min-height: 38px;
			padding: 0 0.95rem;
			font-size: 0.85rem;
		}
		.stats dd {
			font-size: 1.35rem;
		}
		.section-header h2 {
			font-size: 1.15rem;
		}
		.post-card {
			padding: 0.75rem;
		}
		.post-card h3 {
			font-size: 1rem;
		}
		.post-image {
			height: 140px;
		}
		.featured {
			grid-template-columns: 1fr;
		}
	}
</style>
