---
interface Props {
	mode: 'catalog' | 'subject' | 'note' | 'graph';
	subject?: string;
	slug?: string;
}

const { mode, subject = '', slug = '' } = Astro.props;
---

<div id="vault-app" data-mode={mode} data-subject={subject} data-slug={slug}>
	<section id="vault-lock" class="vault-lock">
		<p class="vault-kicker">隐藏知识库</p>
		<h1>输入口令后查阅</h1>
		<p>笔记正文在构建时加密。站点源码和公开索引里没有这一层的内容。</p>
		<form id="vault-form">
			<label class="sr-only" for="vault-user">用户名</label>
			<input id="vault-user" type="text" name="username" autocomplete="username" class="sr-only" value="ssherun" tabindex="-1" />
			<label class="sr-only" for="vault-password">口令</label>
			<input id="vault-password" type="password" name="password" autocomplete="current-password" required />
			<button type="submit">解锁</button>
		</form>
		<p id="vault-error" class="vault-error" hidden></p>
		<p id="vault-hint" class="vault-hint">口令只存在你的本地或部署密钥里，公开页面看不到笔记正文。</p>
	</section>
	<div id="vault-content" hidden></div>
</div>

<script>
	import '../scripts/init-vault.ts';
</script>

<style is:global>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
	#vault-app {
		width: 100%;
		max-width: min(920px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 2rem 0 4rem;
	}
	#vault-app.vault-app-wide {
		max-width: min(1100px, calc(100% - 2rem));
	}
	.vault-lock,
	.vault-header {
		padding: 1.5rem 0 1rem;
	}
	.vault-lock h1,
	.vault-header h1,
	.vault-article h1 {
		margin: 0.2rem 0 0.6rem;
		letter-spacing: -0.03em;
	}
	.vault-kicker {
		color: var(--accent);
		font-size: 0.8rem;
		margin: 0;
	}
	.vault-kicker a {
		color: inherit;
	}
	.vault-lock form {
		display: flex;
		gap: 0.5rem;
		margin: 1.2rem 0 0.6rem;
		max-width: 420px;
	}
	.vault-lock input {
		flex: 1;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--bg-surface);
		color: var(--text-primary);
	}
	.vault-lock button,
	.vault-actions button,
	.vault-actions a {
		padding: 0.65rem 1rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--glass-border);
		background: var(--accent-gradient);
		color: white;
		cursor: pointer;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.vault-actions {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		flex-wrap: wrap;
	}
	.vault-actions button {
		background: transparent;
		color: var(--text-secondary);
	}
	.vault-error {
		color: #dc2626;
		margin: 0.4rem 0 0;
	}
	.vault-hint,
	.vault-meta,
	.vault-lead {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	.vault-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}
	.vault-card,
	.vault-chapter {
		display: block;
		padding: 1rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		background: var(--bg-surface);
		text-decoration: none;
		color: inherit;
	}
	.vault-card h3,
	.vault-chapter h3 {
		margin: 0.4rem 0;
	}
	.vault-card-kicker {
		display: block;
		width: 2rem;
		height: 0.28rem;
		border-radius: 999px;
	}
	.vault-chapter {
		display: grid;
		grid-template-columns: 88px 1fr;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}
	.vault-chapno {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 72px;
		border-radius: var(--radius-md);
		background: var(--accent-gradient);
		color: white;
		font-size: 0.85rem;
		font-weight: 600;
		text-align: center;
		padding: 0.4rem;
	}
	.vault-concepts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1rem 0 1.5rem;
	}
	.vault-concepts a,
	.vault-concepts span {
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--glass-border);
		font-size: 0.75rem;
		color: var(--text-secondary);
		text-decoration: none;
	}
	.vault-toc {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.8rem;
		margin: 0 0 1.6rem;
		padding: 0.8rem 1rem;
		border: 1px dashed var(--glass-border);
		border-radius: var(--radius-md);
		font-size: 0.85rem;
	}
	.vault-toc a {
		color: var(--accent);
		text-decoration: none;
	}
	.vault-search-label {
		display: block;
		margin-top: 1rem;
	}
	.vault-search-label input,
	#notes-graph-search {
		width: min(520px, 100%);
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--bg-surface);
		color: var(--text-primary);
	}
	.vault-search-results {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.6rem;
	}
	.vault-search-results a,
	.vault-search-results button {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		width: 100%;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--bg-surface);
		color: inherit;
		text-align: left;
		cursor: pointer;
		text-decoration: none;
	}
	.vault-search-results span {
		color: var(--accent);
		font-size: 0.75rem;
		min-width: 4.5rem;
	}
	.vault-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.75rem;
	}
	.vault-filters button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		background: var(--bg-surface);
		color: var(--text-secondary);
		cursor: pointer;
	}
	.vault-filters button.active,
	.vault-filters button:hover {
		border-color: var(--accent);
		color: var(--text-primary);
	}
	.vault-filters .swatch {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
	}
	.vault-graph-tools {
		display: flex;
		gap: 0.8rem;
		align-items: center;
		margin-top: 0.75rem;
		color: var(--text-secondary);
		font-size: 0.9rem;
	}
	.vault-graph-tools button {
		padding: 0.35rem 0.7rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--glass-border);
		background: var(--bg-surface);
		color: var(--text-secondary);
		cursor: pointer;
	}
	.vault-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		padding: 0.6rem 0.9rem;
		font-size: 0.78rem;
		color: var(--text-muted);
		border-top: 1px solid var(--glass-border);
	}
	.vault-body .katex-display {
		overflow-x: auto;
		overflow-y: hidden;
		margin: 1rem 0;
	}
	.vault-body .mermaid {
		margin: 1rem 0;
		padding: 0.8rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--bg-surface);
	}
	.vault-exam {
		border-left: 3px solid var(--accent);
		padding-left: 0.8rem;
	}
	.vault-body {
		line-height: 1.75;
	}
	.vault-body h2,
	.vault-body h3 {
		margin-top: 1.8rem;
	}
	.vault-body pre,
	.vault-body table {
		overflow-x: auto;
	}
	.vault-body table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}
	.vault-body th,
	.vault-body td {
		border: 1px solid var(--glass-border);
		padding: 0.4rem 0.55rem;
	}
	.vault-pager {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--glass-border);
	}
	.vault-graph-wrap {
		position: relative;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--bg-surface);
	}
	#notes-cy {
		width: 100%;
		height: 640px;
	}
	#notes-graph-panel {
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: min(260px, calc(100% - 2rem));
		padding: 0.8rem 1rem;
		border-radius: var(--radius-md);
		background: var(--bg-overlay);
		border: 1px solid var(--glass-border);
	}
	@media (max-width: 720px) {
		.vault-chapter {
			grid-template-columns: 1fr;
		}
		.vault-lock form {
			flex-direction: column;
		}
	}
</style>
