---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import {
	currentLocale,
	localeMeta,
	pageAlternates,
	type Alternate,
	type Locale,
} from '../i18n/config';
interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** 文章页用 article，利于社交预览与爬虫 */
	ogType?: 'website' | 'article';
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	locale?: Locale;
	alternates?: Alternate[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageUrl = canonicalURL.href;
const {
	title,
	description,
	image = FallbackImage,
	ogType = 'website',
	articlePublishedTime,
	articleModifiedTime,
	locale = currentLocale(Astro.currentLocale),
	alternates = pageAlternates(Astro.url.pathname, Astro.site),
} = Astro.props;
const meta = localeMeta[locale];
const rssHref = new URL(locale === 'en' ? 'en/rss.xml' : 'rss.xml', Astro.site).href;
const ogImageUrl = new URL(image.src, Astro.site).href;
---

<ClientRouter />

<!-- Theme: 首屏 + 每次 View Transition 后从 localStorage 恢复（否则新页面会丢 data-theme） -->
<script is:inline>
(function () {
	function applyStoredTheme() {
		try {
			var saved = localStorage.getItem('theme');
			var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			var theme = saved || (prefersDark ? 'dark' : 'light');
			document.documentElement.setAttribute('data-theme', theme);
		} catch (e) {}
	}
	applyStoredTheme();
	document.addEventListener('astro:page-load', applyStoredTheme);
})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#00f0ff" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#0891b2" media="(prefers-color-scheme: light)" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="help" href="/llms.txt" type="text/plain" title="LLM-friendly site overview" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={rssHref}
/>
{
	alternates.map((item) => (
		<link
			rel="alternate"
			hreflang={item.locale === 'x-default' ? 'x-default' : localeMeta[item.locale].hreflang}
			href={item.href}
		/>
	))
}
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/sora-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook（绝对 URL 必须用站点 origin，避免预览抓错图/错链） -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={meta.ogLocale} />
{
	alternates
		.filter((item) => item.locale !== 'x-default' && item.locale !== locale)
		.map((item) => (
			<meta property="og:locale:alternate" content={localeMeta[item.locale].ogLocale} />
		))
}
{ogType === 'article' && articlePublishedTime && (
	<meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleModifiedTime && (
	<meta property="article:modified_time" content={articleModifiedTime} />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={pageUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />
