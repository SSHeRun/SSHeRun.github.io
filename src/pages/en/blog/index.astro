---
import PostIndex from '../../../components/PostIndex.astro';
import { currentLocale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import SitePage from '../../../layouts/SitePage.astro';

const locale = currentLocale(Astro.currentLocale);
---

<SitePage title={`${t(locale, 'allPosts')} - ${t(locale, 'siteTitle')}`} description={t(locale, 'siteDescription')}>
	<main>
		<PostIndex />
	</main>
</SitePage>

<style>
	main {
		width: 100%;
		max-width: min(var(--max-width-wide), calc(100% - 2rem));
		box-sizing: border-box;
	}
</style>
