---
import GraphView from '../../components/GraphView.astro';
import { currentLocale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import SitePage from '../../layouts/SitePage.astro';

const locale = currentLocale(Astro.currentLocale);
---

<SitePage
	title={`${t(locale, 'graphTitle')} - ${t(locale, 'siteTitle')}`}
	description={t(locale, 'graphHint')}
	wide
>
	<GraphView />
</SitePage>
