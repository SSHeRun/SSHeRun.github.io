---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BackToTop from '../components/BackToTop.astro';
import BaseHead from '../components/BaseHead.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import CopyCode from '../components/CopyCode.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import ReadingTime from '../components/ReadingTime.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { currentLocale, localeMeta, pageAlternates, switchLocalePath, type Locale } from '../i18n/config';
import { findTranslation } from '../i18n/posts';
import { t } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	slug?: string;
	translationKey?: string;
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags,
	body = '',
	slug = '',
	lang = 'zh',
	translationKey,
	headings = [],
} = Astro.props;
const locale = currentLocale(Astro.currentLocale);
const meta = localeMeta[locale];
const alternates = pageAlternates(Astro.url.pathname, Astro.site);
const otherLocale: Locale = locale === 'en' ? 'zh-CN' : 'en';
const otherPost = translationKey
	? findTranslation(await getCollection('blog'), translationKey, otherLocale)
	: undefined;

const postPageUrl = new URL(Astro.url.pathname, Astro.site).href;
const heroImageUrl = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"datePublished": pubDate.toISOString(),
	...(updatedDate && { "dateModified": updatedDate.toISOString() }),
	"author": {
		"@type": "Person",
		"name": "SSHeRun",
		"url": "https://ssherun.github.io"
	},
	"publisher": {
		"@type": "Person",
		"name": "SSHeRun"
	},
	"url": postPageUrl,
	"inLanguage": meta.htmlLang,
	...(tags && tags.length > 0 && { "keywords": tags.join(", ") }),
	...(heroImageUrl && { "image": [heroImageUrl] }),
};
---

<html lang={meta.htmlLang}>
	<head>
		<BaseHead
			title={`${title} - ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			ogType="article"
			articlePublishedTime={pubDate.toISOString()}
			articleModifiedTime={updatedDate?.toISOString()}
			locale={locale}
			alternates={alternates}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>

	<body>
		<a class="skip-link" href="#main-content">{t(locale, 'skipToContent')}</a>
		<ReadingProgress />
		<Header />
		<main id="main-content" tabindex="-1">
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt={t(locale, 'coverAlt', { title })}
							transition:name={slug ? `post-img-${slug}` : undefined}
						/>
					</div>
				)}
				<div class="article-header">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								({t(locale, 'updatedOn')} <FormattedDate date={updatedDate} />)
							</span>
						)}
						<span class="dot">·</span>
						<ReadingTime content={body} />
					</div>
					<h1>{title}</h1>
					{
						otherPost && (
							<p class="lang-note">
								<a href={switchLocalePath(Astro.url.pathname, otherLocale)}>
									{t(locale, 'otherLangAvailable', { lang: localeMeta[otherLocale].label })}
								</a>
							</p>
						)
					}
					<TagList tags={tags} />
				</div>
				<TableOfContents headings={headings} />
				<div class="prose" data-anchor-label={t(locale, 'headingAnchor')}>
					<slot />
				</div>
				<RelatedPosts slug={slug} tags={tags} body={body} lang={lang} />
				<Giscus term={translationKey || slug} />
			</article>
		</main>
		<Footer />
		<BackToTop />
		<CopyCode />
	</body>
</html>

<script>
	function addHeadingAnchors() {
		const prose = document.querySelector<HTMLElement>('.prose');
		if (!prose) return;
		const label = prose.dataset.anchorLabel ?? '';
		prose.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]').forEach((h) => {
			if (h.querySelector('.heading-anchor')) return;
			const a = document.createElement('a');
			a.className = 'heading-anchor';
			a.href = `#${h.id}`;
			a.textContent = '#';
			a.setAttribute('aria-label', label);
			h.append(a);
		});
	}
	document.addEventListener('astro:page-load', addHeadingAnchors);
</script>

<style>
	main {
		width: 100%;
		max-width: min(760px, calc(100% - 2rem));
		box-sizing: border-box;
	}
	article {
		padding: 2rem 0;
	}

	/* ── Hero Image ── */
	.hero-image {
		margin-bottom: 2.5rem;
		aspect-ratio: 2 / 1;
		overflow: hidden;
		border-radius: var(--radius-xl);
		border: 1px solid var(--glass-border);
		box-shadow: var(--shadow-lg), 0 0 40px color-mix(in srgb, var(--accent) 10%, transparent);
		background: var(--bg-surface);
	}
	.hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	/* ── Article Header ── */
	.article-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.article-header h1 {
		font-size: clamp(1.55rem, 1.1rem + 1.5vw, 2.15rem);
		margin: 0.6rem 0 0.85rem;
		letter-spacing: -0.03em;
		line-height: 1.35;
		text-wrap: balance;
	}

	/* ── Meta ── */
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.88rem;
		color: var(--text-muted);
	}
	.dot {
		opacity: 0.4;
	}
	.updated {
		font-size: 0.83rem;
	}
	.lang-note {
		margin: 0 0 0.85rem;
		font-size: 0.88rem;
	}
	.lang-note a {
		color: var(--accent);
		text-decoration: none;
	}
	.lang-note a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ── Prose ── */
	.prose {
		font-size: 1.05rem;
		line-height: 1.8;
	}
	.prose :global(h2) {
		margin-top: 2.5rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
	}
	.prose :global(h3) {
		margin-top: 2rem;
	}
	.prose :global(p) {
		margin-bottom: 1.5em;
	}
	.prose :global(pre) {
		margin: 1.5em 0;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
	}
	.prose :global(img) {
		border-radius: var(--radius-md);
		margin: 1.5em 0;
		box-shadow: var(--shadow-md);
	}
	.prose :global(blockquote) {
		border-left-color: var(--accent);
		background: var(--glass-bg);
	}
	.prose :global(a) {
		color: var(--accent);
		text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.2s ease;
	}
	.prose :global(a:hover) {
		text-decoration-color: var(--accent);
	}

	.prose :global(h2),
	.prose :global(h3) {
		position: relative;
		scroll-margin-top: calc(var(--header-height) + 1.5rem);
	}
	.prose :global(.heading-anchor) {
		margin-left: 0.4em;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
		opacity: 0;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.prose :global(h2:hover .heading-anchor),
	.prose :global(h3:hover .heading-anchor),
	.prose :global(.heading-anchor:focus-visible) {
		opacity: 1;
	}
	.prose :global(.heading-anchor:hover) {
		color: var(--accent);
	}

	.prose :global(.table-wrapper) {
		margin: 1.75em 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--bg-surface);
		box-shadow: var(--shadow-sm);
	}
	.prose :global(table) {
		width: 100%;
		margin: 0;
		font-size: 0.92em;
		line-height: 1.6;
	}
	.prose :global(th),
	.prose :global(td) {
		border: none;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}
	.prose :global(tr:last-child td) {
		border-bottom: none;
	}
	.prose :global(th) {
		background: color-mix(in srgb, var(--accent) 7%, var(--bg-surface));
		color: var(--text-primary);
		font-size: 0.92em;
		white-space: nowrap;
	}
	.prose :global(tbody tr:nth-child(even)) {
		background: color-mix(in srgb, var(--text-primary) 2.5%, transparent);
	}
	.prose :global(tbody tr:hover) {
		background: color-mix(in srgb, var(--accent) 5%, transparent);
	}

	.prose :global(blockquote) {
		font-style: normal;
		padding: 0.85em 1.1em 0.85em 1.25em;
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		background: color-mix(in srgb, var(--accent) 5%, var(--bg-surface));
	}
	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(figure.md-figure) {
		margin: 2em 0;
	}
	.prose :global(figure.md-figure img) {
		display: block;
		width: 100%;
		margin: 0;
	}
	.prose :global(figcaption) {
		margin-top: 0.7em;
		text-align: center;
		font-size: 0.84rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.prose :global(hr) {
		margin: 3em auto;
		width: 30%;
		background: var(--accent-gradient);
		opacity: 0.5;
	}
	.prose :global(li::marker) {
		color: var(--accent);
	}
	.prose :global(strong) {
		color: var(--text-primary);
	}

	@media (max-width: 720px) {
		main {
			max-width: min(760px, calc(100% - 1.5rem));
		}
		article { padding: 1rem 0; }
		.article-header {
			margin-bottom: 1.5rem;
			padding-bottom: 1rem;
		}
		.article-header h1 {
			font-size: 1.5rem;
		}
		.hero-image {
			border-radius: var(--radius-lg);
		}
		.hero-image {
			margin-bottom: 1.5rem;
		}
		.meta {
			flex-wrap: wrap;
			gap: 0.35rem;
			font-size: 0.82rem;
		}
		.prose {
			font-size: 1rem;
			line-height: 1.75;
		}
		.prose :global(pre) {
			margin: 1em -0.75rem;
			border-radius: 0;
			padding: 1em;
			font-size: 0.82em;
		}
		.prose :global(img) {
			margin: 1em 0;
		}
	}
	@media (max-width: 480px) {
		.article-header h1 {
			font-size: 1.3rem;
		}
		.prose {
			font-size: 0.95rem;
		}
		.prose :global(pre) {
			font-size: 0.78em;
			padding: 0.75em;
		}
	}
</style>
